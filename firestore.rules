rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Research updates: public read-only feed.
    // Writes happen only via the Firebase console / Admin SDK.
    match /research_updates/{updateId} {
      allow read: if true;
      allow write: if false;
    }

    // Per-user document: only the signed-in (anonymous) owner can touch it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
